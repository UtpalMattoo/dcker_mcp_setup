// Runtime Alloy config for the live observability stack.

// ── OTLP traces ──────────────────────────────────────────────────────────────
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  send_batch_size     = 1024
  send_batch_max_size = 2048
  timeout             = "5s"
  output {
    traces = [otelcol.exporter.otlp.lgtm.input]
  }
}

otelcol.exporter.otlp "lgtm" {
  client {
    endpoint = "lgtm:4317"
    tls { insecure = true }
  }
}

// ── App service logs ──────────────────────────────────────────────────────────
loki.source.file "app_logs" {
  targets = [
    { __path__ = "/mnt/service-logs/main_starter_service/app.log",              service = "main_starter_service", env = "local" },
    { __path__ = "/mnt/service-logs/second-service-custom-mcp-work/app.log",    service = "second-service-custom-mcp-work", env = "local" },
  ]
  forward_to = [loki.process.app_extract.receiver]
}

loki.process "app_extract" {
  stage.json {
    expressions = {
      service = "service",
      level   = "level",
    }
  }
  stage.labels {
    values = {
      service = "service",
      level   = "level",
    }
  }
  forward_to = [loki.write.lgtm.receiver]
}

// ── Loki write endpoint ───────────────────────────────────────────────────────
loki.write "lgtm" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}

// ── Prometheus metrics (Qdrant) ───────────────────────────────────────────────
prometheus.scrape "qdrant_metrics" {
  targets = [{
    __address__ = "host.docker.internal:6333",
    job         = "qdrant",
  }]
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.lgtm.receiver]
}

prometheus.remote_write "lgtm" {
  endpoint {
    url = "http://lgtm:9009/api/v1/push"
  }
}

// ── Logging ───────────────────────────────────────────────────────────────────
logging {
  level  = "info"
  format = "json"
}
